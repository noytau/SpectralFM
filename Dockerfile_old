# Use an official PyTorch runtime image as a base.  This image
# includes CUDA 12.8 and cuDNN 9 and comes with conda pre-installed.
# If you are on an ARM (Apple Silicon) machine, build the image for
# the amd64 platform via `docker build --platform linux/amd64 ...`.
FROM pytorch/pytorch:2.1.0-cuda12.1-cudnn8-runtime

# Make sure the conda binaries are on PATH so that both conda and mamba
# will be available during the build.  In the upstream PyTorch images
# conda lives under /opt/conda.  Without this, commands like
# `conda install` and `mamba` may not be found.

WORKDIR /app
# install compiler and git
RUN apt-get update && \
    apt-get install -y build-essential git && \
    rm -rf /var/lib/apt/lists/*

# pin pip < 24.1 to handle omegaconf’s metadata
RUN python -m pip install --no-cache-dir "pip<24.1"

#RUN mkdir /storage/noy/fairseq

# clone and install fairseq (editable)
RUN git clone https://github.com/facebookresearch/fairseq.git /app/fairseq && \    
    cd /app/fairseq && \
    pip install --no-cache-dir -e .

RUN apt-get update && \
    apt-get install -y tmux

ENV FORCE_CUDA=1

# Copy the project source code
COPY . /app/spectralfm_code

ENV PYTHONPATH=/storage/noy/spectralfm_code

RUN apt-get update && \
    apt-get install -y build-essential git tmux openssh-server sudo && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir /var/run/sshd

# Create user 'sshuser' with password 'gYnH1324!' (restoring from your snippet)
RUN useradd -rm -d /home/sshuser -s /bin/bash -g root -G sudo -u 1000 sshuser && \
    echo 'sshuser:gYnH1324!' | chpasswd

# Allow SSH access
EXPOSE 22

# Start the SSH daemon by default
CMD ["/usr/sbin/sshd", "-D"]
